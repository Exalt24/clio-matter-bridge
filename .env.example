# Copy to .env and fill from your Clio developer app
# (developers.clio.com > Developer Apps > your app).

CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=

# One of: us | eu | ca | au. A token issued in one region is NOT valid
# against another region's API, so this must match where you signed up.
CLIO_REGION=us

# Must be https or http://127.0.0.1 . The portal rejects "localhost".
CLIO_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback

# Shared secret you choose, used to authenticate inbound webhook posts.
CLIO_WEBHOOK_SECRET=

# Optional. Enables the intake-to-matter extraction path.
GROQ_API_KEY=
